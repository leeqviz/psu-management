// config for Apollo GraphQL VS Code extension
{
  "client": {
    // Look in 'app', 'components', and 'lib' folders
    "includes": ["app/**/*.tsx", "components/**/*.tsx", "lib/**/*.ts"],
    "service": {
      "name": "psu-management",
      // The URL of your running GraphQL server
      "url": "http://localhost:3000/api/graphql"
    }
  }
}
